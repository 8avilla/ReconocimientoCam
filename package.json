{
  "name": "attendance-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash -c 'set -a && source .env.local && set +a && next dev -p ${PORT:-3096}'",
    "build": "next build",
    "start": "bash -c 'set -a && source .env.local && set +a && next start -p ${PORT:-3096}'",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "calibrate": "tsx scripts/calibrate-faces.ts",
    "reembed": "tsx --env-file=.env.local scripts/reembed-faces.ts",
    "demo:template": "tsx --env-file=.env.local scripts/demo-template.ts",
    "demo:cleanup": "tsx --env-file=.env.local scripts/demo-cleanup.ts",
    "demo:user": "tsx --env-file=.env.local scripts/create-demo-user.ts",
    "thumbs": "tsx --env-file=.env.local scripts/backfill-thumbnails.ts",
    "integrity": "tsx --env-file=.env.local scripts/check-integrity.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@mediapipe/tasks-vision": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "html2canvas": "^1.4.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.47.0",
    "mongoose": "^9.9.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "onnxruntime-node": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "5.0.1"
  }
}
