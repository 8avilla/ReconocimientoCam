PORT=3096

# MongoDB connection string
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>"

# Azure Blob Storage (player faces and team shields)
AZURE_STORAGE_CONNECTION_STRING="<connection string>"
AZURE_STORAGE_DEFAULT_CONTAINER="<container name>"

# Auth.js (Google sign-in) — create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Authorized redirect URI: <your domain>/api/auth/callback/google)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that become admin on their first Google sign-in
ADMIN_EMAILS=

AUTH_URL=https://supertorneos.com.co

# Mailgun (password reset / "set your password" emails)
MAIL_API_KEY=
MAIL_DOMAIN=
MAIL_BASE_URL="https://api.mailgun.net"
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Super Torneos"

# Web Push (avisos en el teléfono). Genera el par con: npx web-push generate-vapid-keys
# La clave pública se compila en la app: hay que definirla antes de `next build`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:soporte@supertorneos.com.co"

# Miniaturas de avatares (rendimiento). Actívalo (=1) DESPUÉS de correr `npm run thumbs` una vez en cada entorno:
# se lee al compilar. Sin esto las imágenes pequeñas pasan por el optimizador de Next la primera vez que se ven.
NEXT_PUBLIC_IMAGE_THUMBS=
